# Which supplier the server-side search routes use: mock | amadeus | duffel
TRAVEL_PROVIDER=mock

# Amadeus Self-Service (https://developers.amadeus.com) — test env by default
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Duffel (https://duffel.com) — use a duffel_test_ token for sandbox
DUFFEL_ACCESS_TOKEN=
